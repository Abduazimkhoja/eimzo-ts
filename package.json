{
  "name": "eimzo-ts",
  "version": "0.1.2",
  "description": "Unofficial framework-agnostic TypeScript client for E-IMZO (Uzbekistan digital signature): key listing, PKCS#7 signing, login by EDS.",
  "license": "MIT",
  "author": "Abduazimkhoja",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abduazimkhuja/eimzo-ts.git"
  },
  "homepage": "https://github.com/abduazimkhuja/eimzo-ts#readme",
  "bugs": {
    "url": "https://github.com/abduazimkhuja/eimzo-ts/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "keywords": [
    "e-imzo",
    "eimzo",
    "e-imzo.js",
    "eri",
    "ecp",
    "digital-signature",
    "electronic-signature",
    "pkcs7",
    "cms",
    "uzbekistan",
    "typescript",
    "angular",
    "react",
    "vue"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "npm run build && npx --yes serve -l 3000 .",
    "check:eimzo": "npm run build && node scripts/check-real-eimzo.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
